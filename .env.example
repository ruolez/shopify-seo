# Copy to .env and fill in real values. .env is gitignored.
#
# ENCRYPTION_KEY: Fernet key protecting stored API tokens at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change it after data exists — existing tokens become unreadable.
#
# SECRET_KEY: Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=postgresql://seo_user:CHANGE_ME@postgres:5432/shopify_seo
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
POSTGRES_DB=shopify_seo
POSTGRES_USER=seo_user
POSTGRES_PASSWORD=CHANGE_ME
